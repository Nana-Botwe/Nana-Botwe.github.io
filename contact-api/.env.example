# Copy to .env (or set these in your host's environment settings)

# Port to listen on. cPanel / Passenger sets this for you.
PORT=3000

# Sites allowed to post to the form (comma separated)
ALLOWED_ORIGINS=https://nana-botwe.github.io

# Where messages.txt is written. Keep it outside public_html.
DATA_DIR=./data

# Time zone used for timestamps and the evening digest
TIME_ZONE=Africa/Accra

# Optional: send the digest from inside the server at this time (HH:MM).
# Leave empty if you use a cron job instead (recommended on cPanel).
DIGEST_AT=

# Max messages per visitor IP per hour
RATE_LIMIT_MAX=5

# Where the evening digest goes
MAIL_TO=isaacnanabotwe@gmail.com
MAIL_FROM="Portfolio Contact <no-reply@inbitfirm.org>"

# SMTP account used to send the digest (e.g. a cPanel mailbox)
SMTP_HOST=mail.inbitfirm.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@inbitfirm.org
SMTP_PASS=change-me

# Set to true to print the digest instead of sending it (for testing)
MAIL_DRY_RUN=false
